{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && npm run bundle",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "tsc -p . --outDir dist-test && node --test test/*.test.mjs",
    "bundle": "esbuild dist/serverless.js --bundle --platform=node --format=cjs --target=node24 --outfile=dist/serverless.bundle.js --log-level=warning --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer --external:@fastify/static --external:@docx-editor.dev/fonts --external:dejavu-fonts-ttf"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@docx-editor.dev/fonts": "^2.37.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
