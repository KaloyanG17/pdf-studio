# Port for the API (frontend dev server proxies /api here)
API_PORT=3001

# Translation provider. Leave empty to auto-pick: DeepL > Claude > MyMemory (free, no key, low daily limit)
TRANSLATION_PROVIDER=

# DeepL (best quality for Bulgarian, free tier = 500k chars/month): https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: an email raises the MyMemory free limit from 5k to 50k chars/day
MYMEMORY_EMAIL=
