{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{node_modules/@docx-editor.dev/fonts/package.json,node_modules/@docx-editor.dev/fonts/assets/**,node_modules/dejavu-fonts-ttf/package.json,node_modules/dejavu-fonts-ttf/ttf/DejaVuSans*.ttf}"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
